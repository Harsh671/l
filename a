apache yml


---
- name: Install Apache on Client
  hosts: webservers
  become: yes

  tasks:

    - name: Update package repository
      apt:
        update_cache: yes

    - name: Install Apache2
      apt:
        name: apache2
        state: present

    - name: Start Apache service
      service:
        name: apache2
        state: started
        enabled: yes
ansible-playbook -i inventory apache.yml
